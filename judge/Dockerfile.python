FROM python:3.12-slim

# The container will run the user's Python code securely
WORKDIR /sandbox

# Create a non-root user for executing code
RUN useradd -m -s /bin/bash sandboxuser
RUN chown -R sandboxuser:sandboxuser /sandbox

USER sandboxuser

# Entrypoint will just receive code from stdin and run it
CMD ["python3", "-c", "import sys; exec(sys.stdin.read())"]
