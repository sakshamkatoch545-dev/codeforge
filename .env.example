# ─── Local Development ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codeforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (Optional)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# ─── Production / Railway ──────────────────────────────────────────────────────
# Railway's Postgres plugin sets DATABASE_URL automatically.
# Set these manually in the Railway dashboard for each service:
#
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# REDIS_URL=redis://default:password@host:6379
# SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
#
# For the frontend service, set this to your Railway backend public URL:
# VITE_API_URL=https://codeforge-backend.up.railway.app/api/v1

# ─── User Accounts ─────────────────────────────────────────────────────────────
# No hardcoded users. Register via the frontend /register page or API:
#   POST /api/v1/users/
#
# To promote a user to superuser (admin):
#   UPDATE "user" SET is_superuser = true WHERE username = 'your_username';

