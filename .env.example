# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codeforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (Optional)
# AI_PROVIDER=openai # or gemini, anthropic
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# IMPORTANT: No hardcoded users or credentials.
# Each user should register their own account via the frontend at /login
# or via the API endpoint POST /api/v1/users/
#
# To create a superuser (admin), register a normal user first, then
# manually update the database:
#   UPDATE "user" SET is_superuser = true WHERE username = 'your_username';
